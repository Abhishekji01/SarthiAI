# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sarthiai?retryWrites=true&w=majority

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<replace-with-a-long-random-string>
JWT_EXPIRES_IN=7d

# Extra browser origins allowed by CORS. The web app served by this server and the
# Android app (https://localhost, capacitor://localhost) are always allowed.
CORS_ORIGINS=

# Serve the built web app from ../web/dist (default: on when the build exists)
SERVE_WEB=

# Optional. Without it, AI routes return 503; the app falls back to Sarthi quick answers
# (deterministic, from real data) and everything else works.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used automatically if GEMINI_MODEL is rejected as unknown
GEMINI_FALLBACK_MODEL=gemini-flash-latest
AI_TIMEOUT_MS=30000
AI_REQUESTS_PER_HOUR=40

LOG_LEVEL=info
# Set to 1 when running behind one reverse proxy (Render, Railway, Fly, etc.)
TRUST_PROXY=0

# Daily scrape of official sources (NSP, NICSI, ISRO, Science Academies).
# Needs Python 3: cd ../ingest && python3 -m venv .venv && .venv/bin/pip install -r requirements.txt
# Defaults to true in production, false otherwise.
ENABLE_DAILY_REFRESH=
REFRESH_HOUR_IST=3
REFRESH_ON_START=false
# Optional: Python interpreter path (defaults to ../ingest/.venv/bin/python, then python3)
INGEST_PYTHON=
